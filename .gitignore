# --- Python / tooling ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Secrets: never commit ---
.env
*.env.local
client_secret*.json
client_secrets*.json
token*.json
oauth*.json
secrets/

# --- Runtime state (per machine) ---
data/*
!data/.gitkeep
config/games_history.json
logs/*
!logs/.gitkeep

# --- Media and generated outputs (large, per machine) ---
01_RAW_INPUT/*
!01_RAW_INPUT/.gitkeep
02_WORK/*
!02_WORK/.gitkeep
03_READY_FOR_REVIEW/*
!03_READY_FOR_REVIEW/.gitkeep
tests/fixtures/generated/
*.mp4
*.mkv
*.mov
*.wav
*.mp3
*.m4a
!tests/fixtures/*.json

# --- OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Local tool config ---
.claude/
