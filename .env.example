# Copy to .env (setup_windows.bat does this once and never overwrites an existing .env).
# Placeholders only. Never commit your real .env.

# Gemini API key from Google AI Studio. Leave empty to use Ollama only.
GEMINI_API_KEY=
# Model ID is validated against the API's model list before use.
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama server and model (e.g. qwen2.5:3b). Leave model empty to choose in the app.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional: path to your Google OAuth client secrets JSON for private YouTube uploads.
# Keep this file OUTSIDE the repository folder.
YOUTUBE_CLIENT_SECRETS_FILE=

# Optional: folder containing ffmpeg.exe and ffprobe.exe if they are not on PATH.
FFMPEG_BIN_DIR=
